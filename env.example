# Absolute path on the Docker host to the WikiArt root (style folders + classes.csv)
WIKIART_PATH=/mnt/data/wikiart

# Host port for the Streamlit UI
APP_PORT=8501

# Tuning (defaults shown). Lower NUM_WORKERS if the host is CPU-starved.
NUM_WORKERS=4
BATCH_SIZE=64
DEVICE=auto
LOG_LEVEL=INFO

# Storage backend: `flat` (default) or `pg` for Supabase/Postgres + pgvector.
# For `pg`, use Supabase's direct database connection string (not the REST URL).
STORE_BACKEND=flat
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require